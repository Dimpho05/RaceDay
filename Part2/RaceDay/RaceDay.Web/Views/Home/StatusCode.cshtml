@model int
@{
    ViewData["Title"] = Model == 404 ? "Page not found" : "Something went wrong";
}

<div class="text-center py-5">
    <h1 class="page-title">@(Model == 404 ? "Page not found" : "Something went wrong")</h1>
    <p class="page-subtitle">
        @(Model == 404
                ? "We could not find the page you were looking for."
                : "That request could not be completed. Please try again.")
    </p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Back to home</a>
</div>