@model EnrolmentsViewModel
@{
    ViewData["Title"] = "Enrolments";
}

<div class="d-flex justify-content-between align-items-end flex-wrap gap-2 mb-3">
    <div>
        <h1 class="page-title">Enrolments</h1>
        <p class="page-subtitle mb-0">@Model.Event.EventName &middot; @Model.Event.EventDate.ToString("d MMM yyyy")</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-controller="ManageEvents" asp-action="Edit" asp-route-id="@Model.Event.EventID" class="btn btn-outline-primary btn-sm">Event details</a>
        <a asp-controller="ManageCategories" asp-action="Index" asp-route-eventId="@Model.Event.EventID" class="btn btn-outline-primary btn-sm">Categories</a>
        <a asp-controller="ManageResults" asp-action="Index" asp-route-eventId="@Model.Event.EventID" class="btn btn-outline-primary btn-sm">Results</a>
        <a asp-controller="ManageEvents" asp-action="Index" class="btn btn-outline-secondary btn-sm">All events</a>
    </div>
</div>

@if (ViewData["ErrorMessage"] is string loadError)
{
    <div class="alert alert-warning" role="alert">@loadError</div>
}

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="rd-card stat-tile">
            <div class="stat-number">@Model.TotalCount</div>
            <div class="stat-label">Participants enrolled</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="rd-card stat-tile">
            <div class="stat-number">@Model.ConfirmedCount</div>
            <div class="stat-label">Confirmed</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="rd-card stat-tile">
            <div class="stat-number">@Model.PendingCount</div>
            <div class="stat-label">Pending</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="rd-card stat-tile">
            <div class="stat-number">@Model.Categories.Count</div>
            <div class="stat-label">Categories in use</div>
        </div>
    </div>
</div>

<div class="rd-card">
    <div class="rd-card-body pb-2">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h2 class="h4 mb-0">Participants</h2>

            @if (Model.Categories.Any())
            {
                <form asp-action="Index" method="get" class="d-flex align-items-center gap-2">
                    <input type="hidden" name="eventId" value="@Model.Event.EventID" />
                    <label for="categoryId" class="form-label mb-0">Category</label>
                    <select id="categoryId" name="categoryId" class="form-select form-select-sm w-auto" onchange="this.form.submit()">
                        <option value="">All categories (@Model.TotalCount)</option>
                        @foreach (var category in Model.Categories)
                        {
                            <option value="@category.CategoryID" selected="@(Model.SelectedCategoryId == category.CategoryID)">
                                @category.CategoryName (@category.Count)
                            </option>
                        }
                    </select>
                    <noscript><button type="submit" class="btn btn-outline-primary btn-sm">Filter</button></noscript>
                </form>
            }
        </div>
    </div>

    @if (Model.TotalCount == 0)
    {
        <div class="rd-card-body text-muted">
            No participants have enrolled in this event yet.
        </div>
    }
    else if (!Model.Enrolments.Any())
    {
        <div class="rd-card-body text-muted">
            No participants are enrolled in this category.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-rd table-hover align-middle">
                <thead>
                    <tr>
                        <th>Participant</th>
                        <th>Email</th>
                        <th>Category</th>
                        <th>Enrolled on</th>
                        <th>Status</th>
                        <th>Change status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var enrolment in Model.Enrolments)
                    {
                        var isConfirmed = string.Equals(enrolment.EnrolmentStatus, "Confirmed", StringComparison.OrdinalIgnoreCase)
                        || string.Equals(enrolment.EnrolmentStatus, "Active", StringComparison.OrdinalIgnoreCase);
                        var isPending = string.Equals(enrolment.EnrolmentStatus, "Pending", StringComparison.OrdinalIgnoreCase);
                        var isCancelled = string.Equals(enrolment.EnrolmentStatus, "Cancelled", StringComparison.OrdinalIgnoreCase);

                        <tr>
                            <td class="fw-semibold">@enrolment.ParticipantName</td>
                            <td>@enrolment.ParticipantEmail</td>
                            <td>@enrolment.CategoryName</td>
                            <td>@enrolment.EnrolmentDate.ToString("d MMM yyyy")</td>
                            <td><partial name="_StatusBadge" model="enrolment.EnrolmentStatus" /></td>
                            <td>
                                <div class="d-flex flex-wrap gap-1">
                                    @if (!isConfirmed)
                                    {
                                        <form asp-action="SetStatus" method="post" class="d-inline">
                                            <input type="hidden" name="enrolmentId" value="@enrolment.EnrolmentID" />
                                            <input type="hidden" name="eventId" value="@Model.Event.EventID" />
                                            <input type="hidden" name="categoryId" value="@Model.SelectedCategoryId" />
                                            <input type="hidden" name="status" value="Confirmed" />
                                            <button type="submit" class="btn btn-primary btn-sm">Confirm</button>
                                        </form>
                                    }
                                    @if (!isPending)
                                    {
                                        <form asp-action="SetStatus" method="post" class="d-inline">
                                            <input type="hidden" name="enrolmentId" value="@enrolment.EnrolmentID" />
                                            <input type="hidden" name="eventId" value="@Model.Event.EventID" />
                                            <input type="hidden" name="categoryId" value="@Model.SelectedCategoryId" />
                                            <input type="hidden" name="status" value="Pending" />
                                            <button type="submit" class="btn btn-outline-secondary btn-sm">Set to pending</button>
                                        </form>
                                    }
                                    @if (!isCancelled)
                                    {
                                        <form asp-action="SetStatus" method="post" class="d-inline"
                                              onsubmit="return confirm('Cancel this enrolment?');">
                                            <input type="hidden" name="enrolmentId" value="@enrolment.EnrolmentID" />
                                            <input type="hidden" name="eventId" value="@Model.Event.EventID" />
                                            <input type="hidden" name="categoryId" value="@Model.SelectedCategoryId" />
                                            <input type="hidden" name="status" value="Cancelled" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm">Cancel</button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>