@model ProfileViewModel
@{
    ViewData["Title"] = "My profile";
}

<h1 class="page-title">My profile</h1>
<p class="page-subtitle">Keep your details up to date and add a picture.</p>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="rd-card">
            <div class="rd-card-body text-center">
                @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
                {
                    <img src="@Model.ProfilePictureUrl" alt="Your profile picture" class="profile-avatar mb-3" />
                }
                else
                {
                    <div class="profile-avatar profile-avatar-empty mb-3 mx-auto">@Model.Initials</div>
                }

                <h2 class="h4 mb-0">@Model.FirstName @Model.LastName</h2>
                <p class="text-muted mb-3">@Model.Email</p>

                <form asp-action="UploadPicture" method="post" enctype="multipart/form-data" class="text-start">
                    <label for="picture" class="form-label">Profile picture</label>
                    <input type="file" id="picture" name="picture" class="form-control mb-2"
                           accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" required />
                    <div class="form-text mb-3">JPG, PNG or WEBP, up to 5 MB.</div>
                    <button type="submit" class="btn btn-primary w-100">Upload picture</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="rd-card">
            <div class="rd-card-body">
                <h2 class="h4 mb-3">Personal details</h2>

                <form asp-action="UpdateDetails" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <input type="hidden" asp-for="Email" />
                    <input type="hidden" asp-for="ProfilePictureUrl" />

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="FirstName" class="form-label"></label>
                            <input asp-for="FirstName" class="form-control" maxlength="50" autocomplete="given-name" />
                            <span asp-validation-for="FirstName" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="LastName" class="form-label"></label>
                            <input asp-for="LastName" class="form-control" maxlength="50" autocomplete="family-name" />
                            <span asp-validation-for="LastName" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="emailDisplay">Email address</label>
                        <input type="email" id="emailDisplay" class="form-control" value="@Model.Email" disabled />
                        <div class="form-text">Your email is your login, so it cannot be changed here.</div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="PhoneNumber" class="form-label"></label>
                        <input asp-for="PhoneNumber" class="form-control" maxlength="20" autocomplete="tel" />
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary">Save changes</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}