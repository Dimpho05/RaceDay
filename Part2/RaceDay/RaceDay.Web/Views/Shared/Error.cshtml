@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}

<div class="text-center py-5">
    <h1 class="page-title">Something went wrong</h1>
    <p class="page-subtitle">We hit a problem on our side. Please try again in a moment.</p>
    @if (Model.ShowRequestId)
    {
        <p class="small text-muted">Reference: @Model.RequestId</p>
    }
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Back to home</a>
</div>