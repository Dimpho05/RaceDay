@model EventFormViewModel
@{
    ViewData["Title"] = "Edit event";
}

<div class="d-flex justify-content-between align-items-end flex-wrap gap-2 mb-3">
    <div>
        <h1 class="page-title">Edit event</h1>
        <p class="page-subtitle mb-0">Change the details of your race.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-controller="ManageCategories" asp-action="Index" asp-route-eventId="@Model.EventID" class="btn btn-outline-primary btn-sm">Categories</a>
        <a asp-controller="ManageEnrolments" asp-action="Index" asp-route-eventId="@Model.EventID" class="btn btn-outline-primary btn-sm">Enrolments</a>
        <a asp-controller="ManageResults" asp-action="Index" asp-route-eventId="@Model.EventID" class="btn btn-outline-primary btn-sm">Results</a>
    </div>
</div>

<div class="rd-card">
    <div class="rd-card-body">
        <form asp-action="Edit" asp-route-id="@Model.EventID" method="post" enctype="multipart/form-data" novalidate>
            <partial name="_EventForm" model="Model" />

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save changes</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}