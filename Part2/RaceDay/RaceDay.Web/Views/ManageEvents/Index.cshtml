@model List<EventDto>
@{
    ViewData["Title"] = "Manage events";
}

<div class="d-flex justify-content-between align-items-end flex-wrap gap-2 mb-3">
    <div>
        <h1 class="page-title">Manage events</h1>
        <p class="page-subtitle mb-0">Create, edit and manage your races.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">+ Create event</a>
</div>

@if (ViewData["ErrorMessage"] is string loadError)
{
    <div class="alert alert-warning" role="alert">@loadError</div>
}

<div class="rd-card">
    @if (!Model.Any())
    {
        <div class="rd-card-body text-center">
            <p class="text-muted mb-3">You have not created any events yet.</p>
            <a asp-action="Create" class="btn btn-primary">Create your first event</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-rd table-hover align-middle">
                <thead>
                    <tr>
                        <th></th>
                        <th>Event</th>
                        <th>Date</th>
                        <th>Location</th>
                        <th>Distance</th>
                        <th>Type</th>
                        <th>Manage</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ev in Model)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(ev.BannerUrl))
                                {
                                    <img src="@ev.BannerUrl" alt="" class="event-thumb" />
                                }
                                else
                                {
                                    <div class="event-thumb event-thumb-empty"></div>
                                }
                            </td>
                            <td class="fw-semibold">@ev.EventName</td>
                            <td>@ev.EventDate.ToString("ddd, d MMM yyyy HH:mm")</td>
                            <td>@ev.Location</td>
                            <td>@ev.Distance.ToString("0.##") km</td>
                            <td><span class="event-type-tag">@ev.EventTypeName</span></td>
                            <td>
                                <div class="d-flex flex-wrap gap-1">
                                    <a asp-action="Edit" asp-route-id="@ev.EventID" class="btn btn-outline-primary btn-sm">Edit</a>
                                    <a asp-controller="ManageCategories" asp-action="Index" asp-route-eventId="@ev.EventID" class="btn btn-outline-secondary btn-sm">Categories</a>
                                    <a asp-controller="ManageEnrolments" asp-action="Index" asp-route-eventId="@ev.EventID" class="btn btn-outline-secondary btn-sm">Enrolments</a>
                                    <a asp-controller="ManageResults" asp-action="Index" asp-route-eventId="@ev.EventID" class="btn btn-outline-secondary btn-sm">Results</a>
                                    <form asp-action="Delete" asp-route-id="@ev.EventID" method="post" class="d-inline"
                                          onsubmit="return confirm('Delete this event? This cannot be undone.');">
                                        <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>