@model EventFormViewModel
@{
    ViewData["Title"] = "Create event";
}

<h1 class="page-title">Create event</h1>
<p class="page-subtitle">Enter the details of your race. You can add categories once it has been created.</p>

<div class="rd-card">
    <div class="rd-card-body">
        <form asp-action="Create" method="post" enctype="multipart/form-data" novalidate>
            <partial name="_EventForm" model="Model" />

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Create event</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}